{
  "name": "plainslides",
  "version": "0.1.1",
  "description": "HTML slide decks that AI agents can build. Headless, offline, zero dependencies.",
  "keywords": [
    "ai-agents",
    "headless",
    "html-presentation",
    "html-slides",
    "llm",
    "offline",
    "presentation",
    "presenter-view",
    "slide-deck",
    "slides"
  ],
  "homepage": "https://github.com/marekh19/plainslides#readme",
  "bugs": {
    "url": "https://github.com/marekh19/plainslides/issues"
  },
  "license": "MIT",
  "author": "Marek Honzal <hi@marekhonzal.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marekh19/plainslides.git"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "llms.txt"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.js",
  "jsdelivr": "./dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout.css": "./dist/layout.css",
    "./structure.css": "./dist/structure.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "build": "tsdown && node scripts/write-css.ts && node scripts/copy-example.ts",
    "dev": "tsdown --watch",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:package": "publint && attw --pack --profile esm-only --exclude-entrypoints ./layout.css ./structure.css",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run --typecheck",
    "test:ci": "tsc -p tsconfig.test.json && pnpm run test && pnpm run test:size",
    "test:size": "size-limit",
    "test:coverage": "vitest run --typecheck --coverage",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.65.1",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.24.0"
}
